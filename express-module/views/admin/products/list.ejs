<h1><%= title %></h1>

<table border="1" cellspacing="0" cellpadding="5">
  <thead>
    <tr>
      <th>ID</th>
      <th>Name</th>
    </tr>
  </thead>
  <tbody>
    <% items.forEach(function(p) { %>
      <tr>
        <td><%= p.id %></td>
        <td><%= p.name %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<a href="/admin/products/new">+ Add Product</a>